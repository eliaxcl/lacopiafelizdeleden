{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacopiafelizdeleden",
  "compatibility_date": "2026-09-11",
  "main": "worker/index.js",
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "lacopiafelizdeleden-books"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PURCHASES",
      "id": "2c733ddc70dc4fb983acc0e8ac9d191a"
    }
  ],
  "assets": {
    "directory": "./public"
  }
}
